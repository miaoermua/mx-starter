# Mix Space core 实例地址（SSR 数据源）
# 开发环境留空则走 mock 假数据；生产必须填写
MX_CORE_URL=https://example.com

# core 版本：main 分支固定 v12.x（/api/v2，SDK 4.4.0），无需修改
MX_API_PREFIX=/api/v2

# SSR 请求 UA，必须含 mx-space 以绕过 core 的 SpiderGuard
MX_SSR_UA=mx-space-mx-starter/0.1.0

# 主题名：对应 core 后台 Snippet 的 name（reference='theme'、公开、YAML）
# aggregate?theme=<MX_THEME_NAME> 读取主题配置
MX_THEME_NAME=mx-starter

# 应用服务器之前的反向代理层数（**含紧邻应用的那一层**，Next 自身不算），
# 决定如何从 x-forwarded-for 里取访客 IP 透传给 core。
#   0 = 不信任任何代理头（Next 直接暴露在公网），不转发 IP：
#       点赞态/阅读去重会退化成全站共用一个 IP，但不可伪造。
#   1 = nginx / Vercel 单层代理（默认）。
#   2 = CDN → nginx。  3 = CDN → nginx → ingress，以此类推。
#
# 代理必须使用**追加**语义（nginx 的 $proxy_add_x_forwarded_for）。
# 若代理改写为 $remote_addr（覆写），或本值大于实际层数，链长会不足以跳过
# 全部可信代理，此时实现会 fail closed（不转发任何 IP）而不是猜测。
# 注意：把本值配大 **1** 就会读到客户端伪造的 XFF 前缀，改这里务必核对拓扑。
MX_TRUSTED_PROXY_HOPS=1
